{
  "kitVersion": 1,
  "gate": ["pnpm typecheck", "pnpm lint", "pnpm test:run"],
  "verify": [
    {
      "name": "lint",
      "globs": ["**/*.{ts,tsx,js,jsx,mjs}"],
      "commands": ["pnpm lint"]
    },
    {
      "name": "typecheck",
      "globs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "vite.config.ts",
        "tailwind.config.ts"
      ],
      "commands": ["pnpm typecheck"]
    },
    {
      "name": "unit-tests",
      "globs": ["src/**"],
      "commands": ["pnpm test:run"]
    },
    {
      "name": "e2e-smoke",
      "globs": [
        "e2e/**",
        "playwright.config.ts",
        "src/views/index-dtf/**",
        "src/views/yield-dtf/**",
        "src/views/home/**",
        "src/state/**",
        "src/hooks/**"
      ],
      "commands": [
        "pnpm exec tsc -p e2e/tsconfig.json --noEmit",
        "pnpm exec vitest run e2e/helpers/tests",
        "pnpm e2e:smoke"
      ]
    },
    {
      "name": "design-system-browser",
      "globs": [
        "src/components/design-system-v1/**",
        "src/components/{button,icon-button,checkbox,dialog,entity-identity,metric,lifecycle-status,empty-state}/**",
        "src/components/ui/v1-*",
        "src/views/internal/design-system/**",
        "src/styles/**",
        "src/app.css",
        "public/**",
        "index.html",
        "tsconfig*.json",
        "src/utils/chart-performance-colors.ts",
        "e2e/design-system/**",
        "e2e/fixtures/**",
        "e2e/helpers/**",
        "playwright.design-system.config.ts",
        "{tailwind,vite,postcss,lingui}.config.*",
        "{package.json,pnpm-lock.yaml,pnpm-workspace.yaml}",
        "llm-workflow.config.json",
        ".github/workflows/design-system.yml"
      ],
      "commands": [
        "pnpm exec vitest run e2e/helpers/tests/design-system-*.test.ts",
        "pnpm design-system:review"
      ]
    },
    {
      "name": "wiki-lint",
      "globs": ["docs/wiki/**"],
      "commands": ["node scripts/llm-workflow/wiki-lint.mjs"]
    }
  ],
  "lenses": {
    "security": [
      "src/state/**",
      "**/issuance/**",
      "**/governance/**",
      "**/staking/**",
      "**/bridge/**",
      "**/auctions/**",
      "src/components/ui/transaction*",
      "src/components/ui/swap*"
    ],
    "product": ["src/**/*.tsx", "src/**/*.css", "src/locales/**"],
    "complexity": [
      "package.json",
      "*.config.*",
      "scripts/**",
      "skills/**",
      "src/components/ui/**",
      "src/components/layout/**",
      "src/state/**",
      "src/utils/**",
      "src/hooks/**"
    ]
  },
  "redFlags": {
    "consoleAllow": []
  },
  "wiki": {
    "ledgerDriftCommits": 15,
    "domainDriftCommits": 5,
    "ledgerRowMaxChars": 700
  }
}
