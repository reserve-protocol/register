{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.cache/**",
    "**/coverage/**",
    "e2e/templates/**",
    "test-results-fork/**",
    "playwright-report-fork/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "wagmi",
            "importNames": ["useReadContracts"],
            "message": "Import useReadContracts from @/hooks/use-read-contracts: wagmi v3 no longer skips the query while a contract has no address."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/hooks/use-read-contracts.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ],
  "settings": {
    "react": {
      "version": "18.3.1"
    }
  }
}
